# Example environment variables for IssueFlow
# Copy to .env and replace values for your environment

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=issueflow
DB_PASS=issueflow
DB_NAME=issueflow

# JWT signing secret (REQUIRED in non-test environments)
JWT_SECRET=your-production-jwt-secret

# Scheduler cron for ticket auto-escalation
ESCALATION_CRON=*/5 * * * *
